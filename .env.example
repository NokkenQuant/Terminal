# Supabase backend variables (required for local server and Vercel API routes)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional table names (defaults already match current backend pipeline)
SUPABASE_PRICES_TABLE="agro_prices"
SUPABASE_METRICS_TABLE="agro_metrics_analysis"
SUPABASE_LATEST_PRICES_VIEW="agro_latest_prices"

# Mercado Pago (premium checkout + webhook)
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MP_WEBHOOK_SECRET="opcional_para_validacao_de_assinatura"
MP_PREMIUM_AMOUNT="49.90"
MP_CURRENCY="BRL"

# Public URL used in checkout return URLs (success/pending/failure)
APP_BASE_URL="erminal-azure.vercel.app"
